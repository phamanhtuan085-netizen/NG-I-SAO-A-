  "description": "Ngôi Sao A+ — Toán song ngữ Anh – Việt, Tiếng Anh, Tư duy cho học sinh mầm non đến lớp 9",
  "scripts": {
    "build:web": "node web-src/build-app.js && cap sync",
    "sync": "cap sync",
    "android": "cap open android",
    "ios": "cap open ios",
    "assets": "capacitor-assets generate --android --ios --iconBackgroundColor '#D71E28' --iconBackgroundColorDark '#7E0E15' --splashBackgroundColor '#D71E28' --splashBackgroundColorDark '#7E0E15'",
    "test": "node web-src/test/gen.test.js 150 && node web-src/test/lessons.test.js && node ai-proxy/test/worker.test.mjs"
  },
  "dependencies": {
    "@capacitor-community/text-to-speech": "^8.0.2",
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.2"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.2",
    "@fontsource/baloo-2": "^5.3.0",
    "@fontsource/lexend": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0"
